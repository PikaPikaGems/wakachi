{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmitOnError": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": ".cache/compiled",
    "skipLibCheck": false
  },
  "include": [
    "src/**/*"
  ]
}
