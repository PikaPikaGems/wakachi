{
  "name": "wakachi",
  "version": "0.1.0",
  "description": "Japanese furigana and word analysis in the browser (Sudachi), with everyday readings. Works on iPhone Safari.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/wakachi.js",
      "default": "./dist/wakachi.js"
    },
    "./text": {
      "types": "./dist/types/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "bin": {
    "wakachi": "./bin/wakachi.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "API.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "files": "node scripts/make-files.mjs",
    "test": "node --test test/*.test.mjs",
    "test:types": "npm run check && tsc -p test/types",
    "prepack": "npm run build",
    "publish:demo": "node scripts/publish-demo.mjs",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "build:test-react": "node test/build-react.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.25.0",
    "kakera": "file:../kakera",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "japanese",
    "furigana",
    "sudachi",
    "morphological-analysis",
    "tokenizer",
    "browser"
  ]
}
